{
  "description": "步虚录 - 走路助力、放置挂机的像素仙侠 RPG",
  "compileType": "game",
  "appid": "touristappid",
  "projectname": "buxulu",
  "cloudfunctionRoot": "cloudfunctions/",
  "setting": {
    "urlCheck": true,
    "es6": false,
    "enhance": false,
    "postcss": false,
    "minified": true,
    "coverView": false,
    "ignoreUploadUnusedFiles": true
  },
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tools"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "dist"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "package-lock.json"
      }
    ],
    "include": []
  }
}
